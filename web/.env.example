# Clerk publishable key (Dashboard > API keys).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Base URL of the SkillManager API.
VITE_API_URL=http://localhost:4000

# Public origin of this site, used for canonical URLs, Open Graph tags, and the sitemap.
VITE_SITE_URL=http://localhost:3000

# Optional display prices for the landing page pricing section, e.g. "€9".
# Leave empty to show plans without amounts (Stripe remains the source of truth).
VITE_PRICE_PRO_MONTHLY=
VITE_PRICE_PRO_YEARLY=

# PostHog product analytics (Project settings > Project API key). Safe for the client.
# Leave empty to disable tracking in local builds.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
