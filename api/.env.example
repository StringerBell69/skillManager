# ── Database ──────────────────────────────────────────────────
# App runtime: transaction pooler (6543 + pgbouncer=true)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma migrate / db push: session pooler (5432) or direct db.PROJECT.supabase.co
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Clerk (Auth) ──────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── Stripe (Billing) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard → Products (EUR)
# Monthly / Yearly
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Optional until Team launches
# STRIPE_PRICE_TEAM_MONTHLY=price_...

# ── App ──────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
# Railway injects PORT — main.ts prefers PORT over API_PORT
# PORT=3001
NODE_ENV=development

# ── Admin ────────────────────────────────────────────────────
ADMIN_API_KEY=change-me-to-a-random-secret

# ── CLI (overrides for dev) ──────────────────────────────────
# SKILLMANAGER_API_URL=http://localhost:3001
