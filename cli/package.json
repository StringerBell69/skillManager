{
  "name": "@skillmanager/cli",
  "version": "0.1.5",
  "description": "SkillManager CLI — install AI agents into Cursor, Claude, Codex, and Gemini",
  "type": "module",
  "bin": {
    "skillmanager": "dist/index.js",
    "sm": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "skillmanager",
    "cli",
    "ai",
    "agents",
    "cursor",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@skillmanager/shared": "workspace:*",
    "commander": "^12.1.0",
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.1.0",
    "open": "^10.1.0",
    "env-paths": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "eslint": "^9.0.0"
  }
}
